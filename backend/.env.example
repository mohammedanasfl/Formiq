APP_NAME=Formiq
APP_ENV=development
DATABASE_URL=postgresql+psycopg://formiq:formiq@localhost:5432/formiq
TEST_DATABASE_URL=postgresql+psycopg://formiq:formiq@localhost:5432/formiq_test
# AI coach (Gemini). Put your own key in .env; never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
# Coach tracing (Langfuse). Off by default; to turn it on, set it to true and put
# your own keys in .env, never here. The coach works the same without it.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TIMEOUT=5
# Access tokens. Put your own secret in .env, never here: for example the 64
# characters `openssl rand -hex 32` prints (at least 32 for HS256, 48 for HS384,
# 64 for HS512). Without it, logging in and every route that needs the
# signed-in user answer 503.
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
